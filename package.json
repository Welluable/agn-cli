{
  "name": "@welluable/agn-cli",
  "version": "0.0.1",
  "description": "A yolo coding agent simple enough to fit in your head.",
  "author": "manojsinghnegi",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agn": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx --env-file=.env",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "llm"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/welluable/agn-cli.git"
  },
  "dependencies": {
    "openai": "^4"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.5"
  }
}
